{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccompanion.local/contracts/living-spec-boundary-coverage-v1.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/coverage"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    }
  ],
  "$defs": {
    "bound": {
      "type": "object",
      "required": [
        "quantity",
        "kind"
      ],
      "properties": {
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "value",
                "unit",
                "op",
                "step",
                "integer"
              ],
              "properties": {
                "type": {
                  "const": "numeric"
                },
                "value": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(?:\\.[0-9]{1,9})?$"
                },
                "unit": {
                  "enum": [
                    "ms",
                    "s",
                    "min",
                    "h",
                    "d",
                    "B",
                    "KB",
                    "MB",
                    "GB",
                    "KiB",
                    "MiB",
                    "items",
                    "chars",
                    "lines",
                    "retries",
                    "files",
                    "percent"
                  ]
                },
                "op": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "lt",
                            "le",
                            "gt",
                            "ge",
                            "eq"
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "lo",
                        "hi",
                        "inclusive_lo",
                        "inclusive_hi"
                      ],
                      "properties": {
                        "type": {
                          "const": "range"
                        },
                        "lo": {
                          "type": "string",
                          "pattern": "^-?[0-9]+(?:\\.[0-9]{1,9})?$"
                        },
                        "hi": {
                          "type": "string",
                          "pattern": "^-?[0-9]+(?:\\.[0-9]{1,9})?$"
                        },
                        "inclusive_lo": {
                          "type": "boolean"
                        },
                        "inclusive_hi": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "step": {
                  "type": "object",
                  "required": [
                    "value",
                    "unit"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(?:\\.[0-9]{1,9})?$"
                    },
                    "unit": {
                      "enum": [
                        "ms",
                        "s",
                        "min",
                        "h",
                        "d",
                        "B",
                        "KB",
                        "MB",
                        "GB",
                        "KiB",
                        "MiB",
                        "items",
                        "chars",
                        "lines",
                        "retries",
                        "files",
                        "percent"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "integer": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "allowed",
                "closed"
              ],
              "properties": {
                "type": {
                  "const": "domain"
                },
                "allowed": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "closed": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "requirement",
        "bounds"
      ],
      "properties": {
        "requirement": {
          "type": "string"
        },
        "links_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bound",
              "cases"
            ],
            "properties": {
              "bound": {
                "$ref": "#/$defs/bound"
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "position",
                    "value",
                    "unit",
                    "expected",
                    "test_id",
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "position": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "unit": {
                      "oneOf": [
                        {
                          "enum": [
                            "ms",
                            "s",
                            "min",
                            "h",
                            "d",
                            "B",
                            "KB",
                            "MB",
                            "GB",
                            "KiB",
                            "MiB",
                            "items",
                            "chars",
                            "lines",
                            "retries",
                            "files",
                            "percent"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "expected": {
                      "enum": [
                        "accepted",
                        "rejected"
                      ]
                    },
                    "test_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "enum": [
                        "tested_pass",
                        "tested_fail",
                        "untested"
                      ]
                    },
                    "reason": {
                      "enum": [
                        null,
                        "no_link",
                        "unit_unknown",
                        "not_executed",
                        "value_mismatch"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
