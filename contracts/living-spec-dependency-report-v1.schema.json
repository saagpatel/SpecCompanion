{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "living-spec-dependency-report-v1.schema.json",
  "title": "Living Spec dependency impact report v1",
  "type": "array",
  "items": {
    "oneOf": [
    {
    "type": "object",
    "required": ["dependent_id", "dependent_text", "path", "explanation", "selected_prerequisite", "broken_prerequisites", "unproven_prerequisites", "qualified_prerequisites"],
    "additionalProperties": false,
    "properties": {
      "dependent_id": { "type": "string" },
      "dependent_text": { "type": "string" },
      "path": { "type": "array", "items": { "type": "string" } },
      "explanation": { "type": "string" },
      "selected_prerequisite": { "oneOf": [{ "$ref": "#/$defs/prerequisite" }, { "type": "null" }] },
      "broken_prerequisites": { "type": "array", "items": { "$ref": "#/$defs/prerequisite" } },
      "unproven_prerequisites": { "type": "array", "items": { "$ref": "#/$defs/prerequisite" } },
      "qualified_prerequisites": { "type": "array", "items": { "$ref": "#/$defs/prerequisite" } }
    }
    },
    {
      "type": "object",
      "required": ["id", "badge"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "badge": { "const": "stale" }
      }
    }
    ]
  },
  "$defs": {
    "prerequisite": {
      "type": "object",
      "required": ["id", "text", "badge", "reasons", "boundary_reference", "failing_test", "failing_test_status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "badge": { "$ref": "living-spec-status-v1.schema.json#/$defs/badge" },
        "reasons": { "$ref": "living-spec-status-v1.schema.json#/$defs/status/properties/reasons" },
        "boundary_reference": { "type": ["string", "null"], "description": "Reference to boundary declarations; case execution details are not included in this export." },
        "failing_test": { "type": ["string", "null"] },
        "failing_test_status": { "enum": ["failed", "errored", null] }
      }
    }
  }
}
