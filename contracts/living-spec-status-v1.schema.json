{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccompanion.local/contracts/living-spec-status-v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "commit",
    "statuses",
    "inputs"
  ],
  "properties": {
    "schema": {
      "const": "living-spec.status/v1"
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "statuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/status"
      }
    },
    "audit": {
      "enum": [
        "fresh",
        "stored"
      ]
    },
    "human_overrides": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of current resolved challenged links accepted by an explicit human override."
    },
    "quantifier_reports": {
      "type": "array",
      "items": {
        "$ref": "living-spec-quantifier-edition-v1.schema.json#/$defs/report"
      }
    },
    "boundary_reports": {
      "type": "array",
      "items": {
        "$ref": "living-spec-boundary-coverage-v1.schema.json#/$defs/coverage"
      }
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "badge": {
      "enum": [
        "proven",
        "broken",
        "unproven",
        "qualified"
      ]
    },
    "status": {
      "type": "object",
      "required": [
        "id",
        "badge",
        "reasons",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "badge": {
          "$ref": "#/$defs/badge"
        },
        "reasons": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "no_link",
                  "link_challenged",
                  "stale_revision",
                  "test_changed",
                  "not_executed",
                  "test_failed",
                  "link_unresolved",
                  "boundary_gap",
                  "human_override"
                ]
              },
              {
                "$ref": "#/$defs/prerequisite_broken"
              },
              {
                "$ref": "#/$defs/prerequisite_unproven"
              },
              {
                "$ref": "#/$defs/prerequisite_qualified"
              },
              {
                "$ref": "#/$defs/dependency_cycle"
              }
            ]
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "test_id",
              "status",
              "duration_ms"
            ],
            "properties": {
              "test_id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "errored",
                  "skipped"
                ]
              },
              "duration_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "admissible": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "mutation": {
          "$ref": "#/$defs/mutation_tier"
        }
      },
      "additionalProperties": false
    },
    "prerequisite_broken": {
      "type": "object",
      "required": [
        "prerequisite_broken"
      ],
      "properties": {
        "prerequisite_broken": {
          "$ref": "#/$defs/dependency_path"
        }
      },
      "additionalProperties": false
    },
    "prerequisite_unproven": {
      "type": "object",
      "required": [
        "prerequisite_unproven"
      ],
      "properties": {
        "prerequisite_unproven": {
          "$ref": "#/$defs/dependency_path"
        }
      },
      "additionalProperties": false
    },
    "prerequisite_qualified": {
      "type": "object",
      "required": [
        "prerequisite_qualified"
      ],
      "properties": {
        "prerequisite_qualified": {
          "$ref": "#/$defs/dependency_path"
        }
      },
      "additionalProperties": false
    },
    "dependency_cycle": {
      "type": "object",
      "required": [
        "dependency_cycle"
      ],
      "properties": {
        "dependency_cycle": {
          "$ref": "#/$defs/dependency_path"
        }
      },
      "additionalProperties": false
    },
    "dependency_path": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mutation_tier": {
      "type": "object",
      "required": ["state", "waived", "signed_off", "survivors"],
      "properties": {
        "state": {"enum": ["mutation_checked", "signed_off", "survived", "stale", "error", "unsupported", "not_run"]},
        "waived": {"type": "integer", "minimum": 0},
        "signed_off": {"type": "integer", "minimum": 0},
        "survivors": {"type": "array", "items": {"$ref": "#/$defs/mutant"}}
      },
      "additionalProperties": false
    },
    "mutant": {
      "type": "object",
      "required": ["id", "file", "function", "line", "ordinal", "operator", "original", "replacement", "outcome"],
      "properties": {
        "id": {"type": "string"}, "file": {"type": "string"}, "function": {"type": "string"},
        "line": {"type": "integer", "minimum": 0}, "ordinal": {"type": "integer", "minimum": 0},
        "operator": {"enum": ["cmp_flip", "arith_swap", "bool_swap", "int_bump"]},
        "original": {"type": "string"}, "replacement": {"type": "string"},
        "outcome": {"enum": ["killed", "survived", "timeout", "unviable"]}
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "test_id",
        "status",
        "duration_ms"
      ],
      "properties": {
        "test_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "errored",
            "skipped"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failure_message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "requirement_inputs": {
      "type": "object",
      "required": [
        "digest",
        "revision",
        "outcomes",
        "depends_on",
        "receipt_digest",
        "test_ids"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "own_badge": {
          "enum": ["proven", "broken", "unproven"]
        },
        "revision": {
          "$ref": "#/$defs/digest"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "test_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": [
        "digest",
        "tool_version",
        "results_file",
        "results_digest",
        "requirements",
        "results_format",
        "outcome_ids"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "results_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "results_digest": {
          "$ref": "#/$defs/digest"
        },
        "requirements": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/requirement_inputs"
          }
        },
        "results_format": {
          "enum": [
            "libtest",
            "junit",
            null
          ]
        },
        "outcome_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "mutation_digest": {
          "$ref": "#/$defs/digest"
        },
        "mutation_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
